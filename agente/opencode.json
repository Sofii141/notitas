{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "backend/tests/ocultas/*": "deny",
      "*.env": "deny"
    },
    "edit": {
      "*": "ask",
      "backend/tests/*": "deny"
    },
    "bash": {
      "*": "ask",
      "git commit *": "deny",
      "git push *": "deny",
      "git merge *": "deny",
      "*ocultas*": "deny",
      "*_Privado*": "deny",
      "*.env*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
